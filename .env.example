# Copy to .env.local and fill from Firebase console > Project settings > Your apps (Web).
# These web config values are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3 site key) for the hosted site.
VITE_RECAPTCHA_SITE_KEY=

# Optional: a fixed App Check debug token for localhost. Never commit a real one.
VITE_APPCHECK_DEBUG_TOKEN=
